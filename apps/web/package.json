{
  "name": "@omnichat/web",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "OmniChat React 19 frontend — embeddable chat widget, full-page chat, agent widget & admin portal",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:widget": "vite build --config vite.config.widget.ts",
    "build:chat-page": "vite build --config vite.config.chat-page.ts",
    "build:agent-widget": "vite build --config vite.config.agent-widget.ts",
    "build:admin": "vite build --config vite.config.admin.ts",
    "build": "bun run build:widget && bun run build:chat-page && bun run build:agent-widget && bun run build:admin",
    "build:client": "bun run build:widget && bun run build:chat-page",
    "build:admin-widget": "bun run build:agent-widget",
    "preview": "vite preview"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.106.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.17",
    "i18next": "^26.7.1",
    "lucide-react": "^0.545.0",
    "marked": "^15.0.12",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.12",
    "react-router-dom": "^7.18.5",
    "socket.io-client": "^4.8.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.4",
    "typescript": "~5.8.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
